@model MyApp.Models.ProductViewModel

<div class="form-group mb-3">
    <label asp-for="Name" class="form-label">product_Name</label>
    <input asp-for="Name" class="form-control" placeholder="اكتب اسم المنتج" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Name" class="form-label">اسم المنتج</label>
    <input asp-for="Price" class="form-control" type="number" step="0.01" />
    <span asp-validation-for="Price" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Description" class="form-label">description</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
</div>

<input type="hidden" asp-for="Id" />